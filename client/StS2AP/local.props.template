<Project>
  <PropertyGroup>
    <!-- Active game installation used for debugging and deploying the built mod. -->
    <STS2GamePath>???\steamapps\common\Slay the Spire 2</STS2GamePath>

    <!--
      Compile-time reference directories. Keep only the three game assemblies in each:

        ???\sts2-reference\v01071\sts2.dll
        ???\sts2-reference\v01071\0Harmony.dll
        ???\sts2-reference\v01071\GodotSharp.dll
        ???\sts2-reference\v01110\sts2.dll
        ???\sts2-reference\v01110\0Harmony.dll
        ???\sts2-reference\v01110\GodotSharp.dll

      A numeric Sts2ApiSignatureRoot remains supported by the release tool. These explicit
      paths are convenient for local builds and are deliberately untracked.
    -->
    <STS2ReferenceDataDir01071>???\sts2-reference\v01071</STS2ReferenceDataDir01071>
    <STS2ReferenceDataDir01110>???\sts2-reference\v01110</STS2ReferenceDataDir01110>

    <!-- Godot 4.5.1 .NET executable used to export the mod's PCK. -->
    <GodotExePath>???\Godot_v4.5.1-stable_mono_win64.exe</GodotExePath>
  </PropertyGroup>
</Project>
